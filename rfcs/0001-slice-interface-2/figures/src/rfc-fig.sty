% House style for the RFC figures.
% Each figure is a `standalone` document; scripts/build_figures.sh turns it
% into the SVG next to this directory.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rfc-fig}

% T1 + Latin Modern: a real underscore glyph in typewriter labels
% (OT1 draws \_ as a detached rule) and vector fonts in the SVG.
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,decorations.pathreplacing,patterns,positioning,calc,fit}

% A white page, so the figure stays readable on a dark-themed viewer.
\pagecolor{white}

% Pin and zone kinds
\definecolor{g3Gnd}{HTML}{D9D9D9}
\definecolor{g3Act}{HTML}{F4B183}
\definecolor{g3Pwr}{HTML}{F8CBAD}
\definecolor{g3Stop}{HTML}{E06666}
\definecolor{g3Bus}{HTML}{BDD7EE}
\definecolor{g3Ctl}{HTML}{C5E0B4}
\definecolor{g3Key}{HTML}{FFE699}
\definecolor{g3Rsv}{HTML}{FFFFFF}
\definecolor{g3Note}{HTML}{555555}
\definecolor{g3Func}{HTML}{F2F2F2}
\definecolor{g3Mcu}{HTML}{DCE6F2}

\tikzset{
  pin/.style={draw, minimum width=1.9cm, minimum height=0.55cm, inner sep=0pt,
              font=\ttfamily\footnotesize},
  note/.style={font=\footnotesize, text=g3Note, align=center},
  zone/.style={draw, align=center, font=\footnotesize},
  brace/.style={decorate, decoration={brace, amplitude=5pt}},
  key/.style={draw, minimum width=0.35cm, minimum height=0.3cm, inner sep=0pt},
}
