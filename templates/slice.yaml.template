# slice.yaml — BREAD Slice Manifest Template
# Copy this file to the root of your Slice repo and fill in values.
# Fields marked "# nullable" can be set to null if unknown/not applicable.
# Validate with: python bread-infra/scripts/validate_manifest.py slice.yaml

schema_version: "1.0"

# ── Identity ──────────────────────────────────────────────────────────────────
id: "slice-xxxx"                  # repo name lowercased, underscores → hyphens
name: "Your Slice Name"
status: "concept"                 # concept | prototype | validated | released | deprecated
category: "actuation"             # actuation | sensing | integrated | power | interface | template | prototype

summary: "One-line description of what this slice does."
description: null                 # nullable — extended description

# ── Versioning ────────────────────────────────────────────────────────────────
version:
  hardware: "0.1.0"
  firmware: null                  # nullable — null if no firmware
  manifest: "0.1.0"

# ── Compatibility ─────────────────────────────────────────────────────────────
compatibility:
  slice_spec: ">=0.1.0 <0.2.0"
  crumbs_protocol: null           # nullable — null if no I2C comms
  anolis_provider_api: null       # nullable — null if no Anolis provider

# ── Hardware ──────────────────────────────────────────────────────────────────
hardware:
  mcu: null                       # nullable — null for passive boards
  # mcu:
  #   type: "dev-board-socket"    # dev-board-socket | embedded
  #   form_factor: "nano"         # nano | nucleo32 | pico | null (for embedded)
  #   primary: "ATmega328P"
  #   supported:
  #     - "ATmega328P"
  primary_ic: null                # nullable
  # primary_ic:
  #   manufacturer: "Manufacturer"
  #   part_number: "PARTNO"
  hw_gen_current: 1
  hw_gen_supported: [1]
  pcb:
    layers: 2
    thickness: "1.6mm"            # nullable
    copper_weight: "1oz"          # nullable
    dimensions: "70mm x 100mm"
  connectors:
    - ref: "J1"
      type: "slice-bus-10pin"
      purpose: "power-and-i2c"
  mounting:
    pattern: "slice-standard-v0"
    hole_size: "M3"
    inset: "5mm"
  pcb_color_prototype: null       # nullable
  pcb_color_production: null      # nullable
  enclosure: null                 # nullable
  # enclosure:
  #   supported: true
  #   path: null

# ── Electrical ────────────────────────────────────────────────────────────────
electrical:
  input_voltage: "12V"            # nullable
  logic_voltage: "5V"             # nullable
  max_current: null               # nullable
  protection: null                # nullable
  # protection:
  #   reverse_polarity: false
  #   input_esd: false
  #   fuse: false
  isolation: null                 # nullable
  # isolation:
  #   present: false

# ── Interfaces ────────────────────────────────────────────────────────────────
interfaces:
  host:
    type: "i2c"
    address_default: null         # nullable — I2C address (decimal)
    address_configurable: false
  data: null                      # nullable
  # data:
  #   inputs: []
  #   outputs:
