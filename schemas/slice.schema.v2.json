{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/feastorg/bread-infra/main/schemas/slice.schema.v2.json",
  "title": "BREAD Slice Manifest v2",
  "description": "slice.yaml, schema 2.x. Holds what a tool reads or a reader needs; a field is added when something reads it. Field paths are the v1 paths. See spec/slice/slice-manifest-spec.md.",
  "type": "object",
  "required": ["schema_version", "id", "name", "summary", "category", "status", "hardware"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.\\d+$",
      "description": "Schema version this manifest conforms to."
    },
    "id": {
      "type": "string",
      "pattern": "^slice-[a-z0-9-]+$",
      "description": "Repo name lowercased, underscores replaced with hyphens."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One-line description of the slice's purpose."
    },
    "category": {
      "type": "string",
      "enum": ["actuation", "sensing", "integrated", "power", "interface", "template", "prototype"],
      "description": "BREADS taxonomy classification."
    },
    "status": {
      "type": "string",
      "enum": ["concept", "development", "built", "released", "retired"],
      "description": "Lifecycle of the board in hardware/: concept (not designed), development (designed, not fabricated), built (fabricated, under test), released (has a g<N>-r<n> tag), retired."
    },
    "hardware": {
      "type": "object",
      "required": ["hw_gen_current", "interface", "pcb", "mounting"],
      "additionalProperties": false,
      "properties": {
        "hw_gen_current": {
          "type": "integer",
          "minimum": 1,
          "description": "Generation (G number) the board in hardware/ is built for, or heading for while in development; see spec/terminology.md."
        },
        "interface": {
          "type": "string",
          "enum": ["SI1"],
          "description": "Slot interface the board meets: SI1 is spec/slice/slice-interface-1.md."
        },
        "pcb": {
          "type": "object",
          "required": ["layers", "dimensions", "thickness"],
          "additionalProperties": false,
          "properties": {
            "layers": { "type": "integer", "minimum": 1 },
            "dimensions": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?mm x \\d+(\\.\\d+)?mm$",
              "description": "Board outline, x by y, e.g. 70mm x 100mm."
            },
            "thickness": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?mm$",
              "description": "Nominal board thickness, e.g. 1.6mm."
            }
          }
        },
        "mounting": {
          "type": "object",
          "required": ["pattern"],
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": ["string", "null"],
              "enum": ["slice-S-v0", "slice-L-v0", null],
              "description": "Board format from spec/slice/slice-interface-1.md: S (70 x 100) or L (100 x 145). Null for a board that meets neither."
            }
          }
        },
        "mcu": {
          "type": ["object", "null"],
          "description": "Null for a board without an MCU.",
          "required": ["form_factor"],
          "additionalProperties": false,
          "properties": {
            "form_factor": {
              "type": "string",
              "enum": ["nano", "nucleo32", "pico"]
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "object",
          "required": ["address_default"],
          "additionalProperties": false,
          "properties": {
            "address_default": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 127,
              "description": "Default 7-bit I2C address, decimal. Null if set at run time or there is none."
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
